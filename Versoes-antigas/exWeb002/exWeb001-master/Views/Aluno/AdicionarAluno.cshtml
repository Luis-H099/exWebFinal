@{
    Layout = "_LayoutLogin";
}

@model exWeb001.Models.Aluno


<form asp-action="Cadastrar" method="post">
    <div class="row">
        <div class="mb-3 col-md-4">
            <label class="form-label">Nome</label>
            <input type="text" asp-for="Nome" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">CPF</label>
            <input type="text" asp-for="Cpf" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Matrícula</label>
            <input type="text" asp-for="Matricula" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Data de Nascimento</label>
            <input type="date" asp-for="DataNascimento" class="form-control" />
        </div>

        <div class="mb-3 col-md-6">
            <label class="form-label">Endereço</label>
            <input type="text" asp-for="Endereco" class="form-control" />
        </div>

        <div class="mb-3 col-md-2">
            <label class="form-label">Número</label>
            <input type="text" asp-for="Numero" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Bairro</label>
            <input type="text" asp-for="Bairro" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Cidade</label>
            <input type="text" asp-for="Cidade" class="form-control" />
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">CEP</label>
            <input type="text" asp-for="Cep" class="form-control" />
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Cadastrar</button>
        <a class="btn btn-secondary" asp-controller="Login" asp-action="Index">Voltar</a>
    </div>
</form>
