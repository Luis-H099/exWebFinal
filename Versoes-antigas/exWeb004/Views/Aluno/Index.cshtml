@model List<Aluno>

@{
    Layout = "_LayoutLogin";
}

<h2 class="text-center mb-4">Lista de Alunos</h2>

<table class="table table-striped table-hover text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Matrícula</th>
            <th scope="col">CPF</th>
            <th scope="col">Data de Nascimento</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var aluno in Model)
            {
                <tr>
                    <td>@aluno.Nome</td>
                    <td>@aluno.Matricula</td>
                    <td>@aluno.Cpf</td>
                    <td>@aluno.Data_De_Nascimento.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="d-grid gap-2 d-md-block">
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Aluno"
                               asp-action="Editar"
                               asp-route-id="@aluno.Id">Editar</a>

                            <a class="btn btn-danger btn-sm"
                               asp-controller="Aluno"
                               asp-action="Excluir"
                               asp-route-id="@aluno.Id">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Nenhum aluno cadastrado.</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    <a class="btn btn-success" asp-controller="Aluno" asp-action="AdicionarAluno">Adicionar Aluno</a>
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Voltar</a>
</div>
