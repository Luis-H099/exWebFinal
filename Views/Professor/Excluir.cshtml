@model Professor

@{
    Layout = "_LayoutLogin";
}

<h2 class="text-center mb-4">Excluir Professor</h2>

<div class="alert alert-danger text-center">
    Tem certeza que deseja excluir o professor <strong>@Model.Nome</strong>?
</div>

<form asp-action="ExcluirConfirmado" method="post" class="text-center">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-controller="Professor" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
