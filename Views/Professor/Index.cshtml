@model List<Professor>

@{
    Layout = "_LayoutLogin";
}

<h2 class="text-center mb-4">Lista de Professores</h2>

<div>
    <form method="get" asp-controller="Professor" asp-action="Index">
        <input type="text" name="nome" class="form-control" placeholder="Buscar Professor..."
               style="width:380px; display:inline-block;" />
        <button type="submit" class="btn btn-primary">Buscar</button>
    </form>
</div>

<table class="table table-striped table-hover text-center align-middle mt-3">
    <thead class="table-dark">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Disciplina</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var professor in Model)
            {
                <tr>
                    <td>@professor.Id</td>
                    <td>@professor.Nome</td>
                    <td>@professor.Email</td>
                    <td>@professor.Disciplina</td>
                    <td>
                        <div class="d-grid gap-2 d-md-block">
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Professor"
                               asp-action="Editar"
                               asp-route-id="@professor.Id">Editar</a>

                            <a class="btn btn-danger btn-sm"
                               asp-controller="Professor"
                               asp-action="Excluir"
                               asp-route-id="@professor.Id">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Nenhum professor encontrado.</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    <a class="btn btn-success" asp-controller="Professor" asp-action="AdicionarProfessor">Adicionar Professor</a>
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Voltar</a>
</div>
